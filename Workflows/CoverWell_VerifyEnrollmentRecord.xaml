        <InArgument x:TypeArguments="x:Object"><VisualBasicValue x:TypeArguments="x:Object" ExpressionText="in_ConfirmationNumber.Trim()" /></InArgument>
      </uta:VerifyExpressionWithOperator.FirstExpression>
      <uta:VerifyExpressionWithOperator.SecondExpression>
        <InArgument x:TypeArguments="x:Object"><VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;^CW-[0-9]{8}$&quot;" /></InArgument>
      </uta:VerifyExpressionWithOperator.SecondExpression>
    </uta:VerifyExpressionWithOperator>
